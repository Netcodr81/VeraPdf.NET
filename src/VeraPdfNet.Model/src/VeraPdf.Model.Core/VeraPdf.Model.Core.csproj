<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>true</IsPackable>
    <PackageId>VeraPdf.Model</PackageId>
    <Version>0.1.0-preview</Version>
    <Authors>veraPDF Consortium; C# port contributors</Authors>
    <Description>Native .NET contracts for the veraPDF validation model. Does not include parser adapters or a validation engine.</Description>
    <PackageLicenseExpression>GPL-3.0-or-later OR MPL-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/Netcodr81/VeraPdf.NET</RepositoryUrl>
    <PackageProjectUrl>https://github.com/Netcodr81/VeraPdf.NET</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Generated\schema.json" />
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
    <None Include="..\..\THIRD-PARTY-NOTICES.md" Pack="true" PackagePath="/" />
    <None Include="..\..\..\..\java_code\veraPDF-model-integration\LICENSE.GPL" Pack="true" PackagePath="/" />
    <None Include="..\..\..\..\java_code\veraPDF-model-integration\LICENSE.MPL" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
