<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>true</IsPackable>
    <PackageId>VeraPdf.Parser</PackageId>
    <Version>0.7.0-preview</Version>
    <Authors>veraPDF Consortium; C# port contributors</Authors>
    <Description>Native C#/.NET parser for veraPDF PDF document structures.</Description>
    <PackageLicenseExpression>GPL-3.0-or-later OR MPL-2.0</PackageLicenseExpression>
    <RepositoryUrl>https://github.com/veraPDF/veraPDF-parser</RepositoryUrl>
    <PackageProjectUrl>https://docs.verapdf.org/</PackageProjectUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\..\..\java_code\veraPDF-parser\src\main\resources\font\stdmetrics\*.afm"
                      Link="FontData\%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
